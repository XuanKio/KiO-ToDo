{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Focus",
  "version": "0.1.0",
  "identifier": "com.xuankio.devfocus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dev Focus",
        "width": 1120,
        "height": 740,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": { "pubkey": "", "endpoints": [] }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" } }
  }
}
